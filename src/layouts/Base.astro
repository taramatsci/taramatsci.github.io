---
interface Props {
  title: string;
}
const { title } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/blog', label: 'Blog' },
];
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Dr Tara Mishra</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-gray-900 font-sans max-w-3xl mx-auto px-6 py-10">
    <header class="flex justify-between items-center mb-12 border-b pb-4">
      <a href="/" class="font-semibold text-lg tracking-tight">Tara Mishra</a>
      <nav class="flex gap-6 text-sm text-gray-500">
        {nav.map(({ href, label }) => (
          <a href={href} class="hover:text-black transition-colors">{label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-20 pt-4 border-t text-xs text-gray-400 text-center">
      © {new Date().getFullYear()} Tara Mishra · Lawrence Berkeley National Laboratory
    </footer>
  </body>
</html>
