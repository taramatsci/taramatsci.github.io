---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { profile, positions, education, awards, grants, patents, pressCoverage, skills } from '../data/site';
---
<Base title="CV" description="Curriculum vitae of Tara P. Mishra: positions, education, honors, grants and patents.">
  <PageHeader eyebrow="Curriculum vitae" title="Experience & recognition">
    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href={profile.links.cv} class="btn-primary"><Icon name="cv" />Download full CV (PDF)</a>
      <a href="/publications" class="btn">Publications</a>
      <a href="/talks" class="btn">Talks</a>
    </div>
  </PageHeader>

  <div class="divide-y divide-rule">
    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Positions</h2>
      <ol class="space-y-6">
        {positions.map((p) => (
          <li class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <span class="font-mono text-[12px] text-muted sm:pt-1">{p.period}</span>
            <div>
              <p class="font-medium text-ink">{p.title}</p>
              <p class="text-[14.5px] text-ink/80">{p.org}</p>
              {p.detail && <p class="text-[13.5px] text-muted">{p.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Education</h2>
      <ol class="space-y-6">
        {education.map((p) => (
          <li class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <span class="font-mono text-[12px] text-muted sm:pt-1">{p.period}</span>
            <div>
              <p class="font-medium text-ink">{p.title}</p>
              <p class="text-[14.5px] text-ink/80">{p.org}</p>
              {p.detail && <p class="text-[13.5px] text-muted">{p.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Honors &amp; awards</h2>
      <ol class="space-y-5">
        {awards.map((a) => (
          <li class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <span class="font-mono text-[12px] text-muted sm:pt-1">{a.date}</span>
            <div>
              <p class="font-medium text-ink">{a.title}</p>
              <p class="text-[13.5px] text-muted">{a.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Grants &amp; funding</h2>
      <ol class="grid gap-5 md:grid-cols-2">
        {grants.map((g) => (
          <li class="card p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="chip border-accent/40 text-accent">{g.role}</span>
              <span class="font-mono text-[12px] text-muted">{g.date}</span>
            </div>
            <p class="mt-3 font-serif text-[1.15rem] leading-snug">“{g.title}”</p>
            <p class="mt-2 text-[13px] leading-snug text-muted">{g.program}</p>
            <p class="mt-3 font-mono text-[13px] text-ink">{g.amount}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Patents</h2>
      <ol class="space-y-5">
        {patents.map((p) => (
          <li>
            <p class="font-medium text-ink">{p.title}</p>
            <p class="text-[13.5px] text-muted">
              {p.url ? <a href={p.url} target="_blank" rel="noopener" class="link text-muted">{p.detail}</a> : p.detail}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Expertise</h2>
      <div class="grid gap-8 sm:grid-cols-3">
        {skills.map((s) => (
          <div>
            <p class="eyebrow">{s.group}</p>
            <ul class="mt-3 space-y-1.5 text-[14px] text-ink/85">
              {s.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="grid gap-6 py-12 lg:grid-cols-[14rem_1fr]">
      <h2 class="font-serif text-2xl">Research in the news</h2>
      <ol class="space-y-5">
        {pressCoverage.map((p) => (
          <li class="grid gap-1 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <span class="font-mono text-[12px] text-muted sm:pt-1">{p.date}</span>
            <div>
              <a href={p.url} target="_blank" rel="noopener" class="font-medium text-ink hover:text-accent">{p.title}</a>
              <p class="text-[13.5px] text-muted">{p.outlet}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
