---
import Base from '../layouts/Base.astro';
import { readFileSync } from 'fs';
import bibtexParse from 'bibtex-parse';

const raw = readFileSync('./src/content/publications/refs.bib', 'utf-8');
const parsed = bibtexParse.parse(raw);

type BibEntry = {
  type: string;
  id: string;
  properties: Record<string, { value: string }>;
};

function prop(e: BibEntry, key: string): string {
  return e.properties[key]?.value ?? '';
}

function venue(e: BibEntry): string {
  return prop(e, 'journal') || prop(e, 'booktitle') || prop(e, 'school') || '';
}

function formatAuthors(raw: string): string {
  return raw
    .split(' and ')
    .map((a) => {
      a = a.trim();
      const comma = a.indexOf(',');
      if (comma === -1) return a; // already "First Last" style
      const last  = a.slice(0, comma).trim();  // e.g. "Mishra*"
      const first = a.slice(comma + 1).trim(); // e.g. "Tara P"
      return `${first} ${last}`;
    })
    .join(', ');
}

function highlightName(authors: string): string {
  // After formatting, names look like "Tara P Mishra*" or "Tara Prasad Mishra"
  return authors.replace(
    /Tara\s+(?:P(?:rasad)?\s+)?Mishra\*?/g,
    (m) => `<strong class="text-gray-900 font-semibold">${m}</strong>`
  );
}

const allEntries: BibEntry[] = parsed.entries;

function byCategory(cat: string) {
  return allEntries
    .filter((e) => prop(e, 'category') === cat)
    .sort((a, b) => Number(prop(b, 'year') || 0) - Number(prop(a, 'year') || 0));
}

const lead        = byCategory('lead');
const significant = byCategory('significant');
const coauthor    = byCategory('coauthor');
const thesis      = byCategory('thesis');

const sections = [
  { label: 'Lead or Co-Lead Author', entries: lead },
  { label: 'Significant Contributions', entries: significant },
  { label: 'Co-Author', entries: coauthor },
  { label: 'PhD Thesis', entries: thesis },
];
---
<Base title="Publications">
  <div class="flex items-baseline justify-between mb-8">
    <h1 class="text-2xl font-bold">Publications</h1>
    <a
      href="https://scholar.google.com/citations?user=vtbEcEsAAAAJ&hl=en"
      target="_blank"
      rel="noopener"
      class="text-sm text-blue-600 underline hover:text-blue-800"
    >
      Google Scholar
    </a>
  </div>

  {sections.map(({ label, entries }) => entries.length > 0 && (
    <section class="mb-12">
      <h2 class="text-base font-semibold text-gray-500 uppercase tracking-wide mb-5 border-b pb-2">
        {label}
      </h2>
      <ol class="flex flex-col gap-6 list-decimal list-outside ml-5">
        {entries.map((e) => {
          const title   = prop(e, 'title').replace(/\$/g, '');
          const authors = formatAuthors(prop(e, 'author'));
          const year    = prop(e, 'year');
          const v       = venue(e);
          const doi     = prop(e, 'doi');

          return (
            <li class="pl-1 text-sm leading-relaxed text-gray-800">
              <span class="text-gray-500 text-xs mr-1">{year}</span>
              <span class="font-medium">{title}.</span>
              {' '}
              <span class="text-gray-500" set:html={highlightName(authors) + '.'}></span>
              {' '}
              {v && <span class="italic font-semibold text-gray-700">{v}</span>}
              {doi && (
                <>
                  {' · '}
                  <a
                    href={`https://doi.org/${doi}`}
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:text-blue-800 font-mono text-xs"
                  >
                    {doi}
                  </a>
                </>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</Base>
