---
import Base from '../layouts/Base.astro';
---
<Base title="Home">
  <section class="flex flex-col gap-8">
    <div class="flex gap-8 items-start">
      <img
        src="/profile.jpg"
        alt="Tara Mishra"
        class="w-32 h-32 rounded-full object-cover flex-shrink-0"
      />
      <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-bold">Dr Tara Mishra</h1>
        <p class="text-gray-500">Project Scientist · Lawrence Berkeley National Laboratory</p>
        <div class="flex gap-3 text-sm text-gray-500 mt-2 flex-wrap">
          <a href="mailto:tmishra@lbl.gov" class="underline hover:text-black">Email</a>
          <span>·</span>
          <a href="/cv.pdf" class="underline hover:text-black">CV</a>
          <span>·</span>
          <a href="https://github.com/taramatsci" class="underline hover:text-black" target="_blank" rel="noopener">GitHub</a>
          <span>·</span>
          <a href="https://scholar.google.com" class="underline hover:text-black" target="_blank" rel="noopener">Google Scholar</a>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4 text-gray-700 leading-relaxed">
      <p>
        I am a Project Scientist at Lawrence Berkeley National Laboratory. My research focuses on
        [describe your research area here].
      </p>
      <p>
        Previously, I [prior positions or institutions]. I received my PhD from [university].
      </p>
    </div>
  </section>
</Base>
