---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog">
  <h1 class="text-2xl font-bold mb-8">Blog</h1>

  {posts.length === 0 ? (
    <p class="text-gray-500">No posts yet.</p>
  ) : (
    <ul class="flex flex-col gap-6">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="font-medium hover:underline">
            {post.data.title}
          </a>
          <p class="text-sm text-gray-400">{post.data.date.toDateString()}</p>
          {post.data.description && (
            <p class="text-sm text-gray-600 mt-0.5">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</Base>
