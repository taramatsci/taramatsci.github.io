---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const years = [...new Set(news.map((n) => n.data.date.getUTCFullYear()))];
const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
---
<Base title="News" description="News, talks, awards and publications from Tara P. Mishra.">
  <PageHeader eyebrow="News" title="What’s new" />

  <div class="mt-6">
    {years.map((year) => (
      <section class="grid gap-2 border-b border-rule py-8 sm:grid-cols-[7rem_1fr] sm:gap-8">
        <h2 class="font-serif text-3xl text-muted/70">{year}</h2>
        <ul class="space-y-7">
          {news.filter((n) => n.data.date.getUTCFullYear() === year).map((item) => (
            <li class="grid gap-1 sm:grid-cols-[3.5rem_1fr] sm:gap-4">
              <span class="font-mono text-[12px] text-muted sm:pt-1.5">{fmtMonth(item.data.date)}</span>
              <div>
                {item.data.tag && <span class="chip">{item.data.tag}</span>}
                <p class="mt-2 font-serif text-[1.2rem] leading-snug">
                  {item.data.link ? (
                    <a href={item.data.link} target="_blank" rel="noopener" class="hover:text-accent">{item.data.title} <span aria-hidden="true" class="text-muted">↗</span></a>
                  ) : item.data.title}
                </p>
                <p class="mt-1 text-[14.5px] leading-relaxed text-muted">{item.data.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
