---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<header class="border-b border-rule pb-10 pt-6 sm:pt-10">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="mt-3 font-serif text-4xl font-medium leading-[1.08] sm:text-5xl">{title}</h1>
  {lead && <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-muted">{lead}</p>}
  <slot />
</header>
